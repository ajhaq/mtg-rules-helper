{
  "name": "mtg-rules-helper",
  "version": "0.1.0",
  "description": "Ingestion and retrieval layer for an MTG comprehensive-rules Q&A tool",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/src/db/schema.sql')\"",
    "ingest:cards": "tsx src/ingest/cli.ts cards",
    "ingest:rules": "tsx src/ingest/cli.ts rules",
    "ingest:embeddings": "tsx src/ingest/cli.ts embeddings",
    "query": "tsx scripts/query.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx scripts/eval.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "test": "vitest run",
    "serve": "tsx src/server/index.ts",
    "start": "node dist/src/server/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.4",
    "@xenova/transformers": "^2.17.2",
    "fastest-levenshtein": "^1.0.16",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true,
    "protobufjs@6.11.6": true
  }
}
